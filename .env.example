# Pooled connection for application traffic
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/neondb?sslmode=require
NODE_ENV=development
PORT=3001
# Generate a strong, unique secret for backend JWT authentication
JWT_SECRET=replace-with-a-long-random-backend-secret
# Comma-separated email addresses allowed to access admin endpoints
ADMIN_EMAILS=admin@example.com
# URL of the frontend allowed to access the API
FRONTEND_URL=http://localhost:3000
# Base URL of the backend API, including the API version path
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Configure only if your authentication implementation uses AUTH_SECRET
AUTH_SECRET=replace-with-a-long-random-frontend-secret
# Confirm that your database configuration reads this variable
DB_SSL=true